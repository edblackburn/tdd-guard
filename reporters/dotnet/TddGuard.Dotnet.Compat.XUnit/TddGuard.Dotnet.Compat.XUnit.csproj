<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.core" Version="3.*" />
    <PackageReference Include="xunit.v3.assert" Version="3.*" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.*" />
    <PackageReference Include="xunit.v3.core.mtp-v1" Version="3.*">
      <ExcludeAssets>all</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TddGuard.Dotnet/TddGuard.Dotnet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <TestingPlatformBuilderHook Include="TddGuard.Dotnet">
      <DisplayName>TddGuard.Dotnet</DisplayName>
      <TypeFullName>TestingPlatformBuilderHook</TypeFullName>
    </TestingPlatformBuilderHook>
  </ItemGroup>

</Project>
